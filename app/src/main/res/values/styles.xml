<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.noActionBar" parent="AppTheme">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="normalEditText" parent="TextAppearance.AppCompat">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:textSize">@dimen/text_normal</item>
        <item name="android:textColor">@color/textColor</item>
    </style>

    <style name="latoRegularEditText" parent="normalEditText">
        <item name="android:fontFamily">@font/font_lato_reguler</item>
        <item name="android:background">@drawable/border_grey</item>
    </style>

    <style name="registrationForm" parent="latoRegularEditText">
        <item name="android:paddingStart">@dimen/margin_medium</item>
        <item name="android:paddingEnd">@dimen/margin_medium</item>
        <item name="android:singleLine">true</item>
        <item name="android:textSize">@dimen/text_medium</item>
    </style>

    <style name="transactionForm" parent="latoRegularEditText">
        <item name="android:paddingStart">@dimen/margin_medium</item>
        <item name="android:paddingEnd">@dimen/margin_medium</item>
        <item name="android:singleLine">true</item>
        <item name="android:textSize">@dimen/text_medium</item>
    </style>

    <style name="normalButton" parent="Base.Widget.AppCompat.Button">
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:textSize">@dimen/text_medium</item>
    </style>

    <style name="submitButton" parent="normalButton">
        <item name="android:fontFamily">@font/font_lato_bold</item>
        <item name="android:background">@drawable/base_button_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:text">SUBMIT</item>
    </style>

    <style name="nextButton" parent="submitButton">
        <item name="android:text">BERIKUTNYA</item>
    </style>

    <style name="loginButton" parent="submitButton">
        <item name="android:text">MASUK</item>
    </style>

    <style name="normalTextView" parent="TextAppearance.AppCompat">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/textColor</item>
        <item name="android:lineSpacingExtra">@dimen/margin_very_small</item>
    </style>

    <style name="latoSemiBoldTextView" parent="normalTextView">
        <item name="android:fontFamily">@font/font_lato_bold</item>
    </style>

    <style name="latoRegularTextView" parent="normalTextView">
        <item name="android:fontFamily">@font/font_lato_reguler</item>
    </style>

    <style name="headerTextView" parent="normalTextView">
        <item name="android:fontFamily">@font/font_lato_bold</item>
        <item name="android:textColor">@color/colorPrimaryDark</item>
        <item name="android:textSize">@dimen/text_big</item>
    </style>

    <style name="normalInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="colorControlNormal">@color/textColor</item>
        <item name="colorControlActivated">@color/colorPrimary</item>
        <item name="colorControlHighlight">@color/colorPrimary</item>
        <item name="android:textColorHint">@color/textColor</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:theme">@style/normalInputLayout</item>
    </style>

    <style name="loginFormInputLayout" parent="normalInputLayout">
        <item name="colorControlNormal">@color/colorPrimary</item>
    </style>

    <style name="normalOldInputLayout" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorControlNormal">@color/textColor</item>
        <item name="colorControlActivated">@color/colorPrimary</item>
        <item name="colorControlHighlight">@color/colorPrimary</item>
        <item name="android:textColorHint">@color/textColor</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:theme">@style/normalInputLayout</item>
    </style>

    <style name="passwordInputLayout" parent="normalInputLayout">
        <item name="android:layout_marginTop">@dimen/margin_medium</item>
        <item name="android:theme">@style/passwordInputLayout</item>
    </style>

    <style name="Line" parent="TextAppearance.AppCompat">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/lineColor</item>
    </style>

    <style name="Devider" parent="Line">
        <item name="android:layout_height">@dimen/margin_large</item>
        <item name="android:background">@color/transparent</item>
    </style>

    <style name="ViewFullScreen" parent="Line">
        <item name="android:layout_height">match_parent</item>
        <item name="android:background">@color/transparent</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="FakeViewFull" parent="ViewFullScreen">
        <item name="android:visibility">gone</item>
    </style>

    <style name="CardNormal" parent="Theme.MaterialComponents">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="cardCornerRadius">@dimen/card_radius</item>
        <item name="android:layout_marginTop">@dimen/margin_medium</item>
        <item name="android:layout_marginStart">@dimen/margin_medium</item>
        <item name="android:layout_marginEnd">@dimen/margin_medium</item>
        <item name="android:layout_marginBottom">@dimen/margin_medium</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="cardUseCompatPadding">true</item>
    </style>

    <style name="SplashTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@null</item>
        <item name="android:windowDisablePreview">true</item>
    </style>

    <style name="Loading" parent="AVLoadingIndicatorView">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="indicatorName">BallSpinFadeLoaderIndicator</item>
        <item name="indicatorColor">@color/colorPrimary</item>
    </style>

    <!-- for text -->
    <style name="AppTabTextAppearance" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">@dimen/text_medium</item>
        <item name="android:textColor">@color/grey</item>
        <item name="textAllCaps">false</item>
        <item name="android:fontFamily">@font/font_lato_bold</item>
    </style>

</resources>
