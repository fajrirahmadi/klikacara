<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
			xmlns:tools="http://schemas.android.com/tools"
			xmlns:app="http://schemas.android.com/apk/res-auto"
			android:id="@+id/orderNavGraph"
			app:startDestination="@id/eventDetailFragment">

	<fragment android:id="@+id/eventDetailFragment"
			  tools:layout="@layout/fragment_create_event"
			  android:label="OrderDetailFragment"
			  android:name="co.id.klikacara.createevent.view.EventDetailFragment">

		<action android:id="@+id/action_move_fromEventDetailFragment_toOrderAddressAndTimeFragment"
				app:destination="@+id/orderAddressAndTimeFragment"
				app:enterAnim="@anim/enter_from_right"
				app:exitAnim="@anim/exit_to_left"
				app:popEnterAnim="@anim/exit_to_right"
				app:popExitAnim="@anim/enter_from_left"/>

	</fragment>

	<fragment android:id="@+id/orderAddressAndTimeFragment"
			  tools:layout="@layout/fragment_order_address_and_time"
			  android:label="OrderAddressFragment"
			  android:name="co.id.klikacara.createevent.view.OrderAddressAndTimeFragment">
		<action android:id="@+id/action_move_fromOrderAddressAndTimeFragment_toPaymentFragment"
				app:destination="@+id/orderPaymentFragment"
				app:enterAnim="@anim/enter_from_right"
				app:exitAnim="@anim/exit_to_left"
				app:popEnterAnim="@anim/exit_to_right"
				app:popExitAnim="@anim/enter_from_left"/>
	</fragment>

	<fragment android:id="@+id/orderPaymentFragment"
			  tools:layout="@layout/fragment_order_bank_list"
			  android:label="OrderPaymentFragment"
			  android:name="co.id.klikacara.order.view.fragment.OrderPaymentFragment">
		<action android:id="@+id/action_move_fromOrderPaymentFragment_toOrderConfirmationFragment"
				app:destination="@+id/orderConfirmationFragment"
				app:enterAnim="@anim/enter_from_right"
				app:exitAnim="@anim/exit_to_left"
				app:popEnterAnim="@anim/exit_to_right"
				app:popExitAnim="@anim/enter_from_left"/>
	</fragment>

	<fragment android:id="@+id/orderConfirmationFragment"
			  tools:layout="@layout/fragment_order_konfirmasi"
			  android:label="OrderConfirmationFragment"
			  android:name="co.id.klikacara.order.view.fragment.OrderConfirmationFragment"/>

</navigation>