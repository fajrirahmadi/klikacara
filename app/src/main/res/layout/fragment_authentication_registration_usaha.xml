<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:background="@color/white"
        android:layout_height="match_parent">

    <include layout="@layout/base_appbar_primary_with_logo"/>

    <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior">
        <LinearLayout
                android:padding="@dimen/margin_medium"
                android:layout_width="match_parent"
                android:orientation="vertical"
                android:focusableInTouchMode="true"
                android:layout_height="match_parent">

            <androidx.appcompat.widget.AppCompatTextView
                    style="@style/normalTextView"
                    android:layout_marginTop="@dimen/margin_medium"
                    android:text="@string/label_description"/>
            <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/descriptionEditText"
                    style="@style/registrationForm"
                    android:layout_marginTop="@dimen/margin_small"
                    android:hint="@string/label_description"/>

            <androidx.appcompat.widget.AppCompatTextView
                    style="@style/normalTextView"
                    android:layout_marginTop="@dimen/margin_medium"
                    android:text="@string/label_slogan"/>
            <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/sloganEditText"
                    style="@style/registrationForm"
                    android:layout_marginTop="@dimen/margin_small"
                    android:hint="@string/label_slogan"/>

            <RelativeLayout
                    android:layout_marginTop="@dimen/margin_medium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/labelFoto"
                        android:text="@string/label_mitra_picture"
                        style="@style/normalTextView"/>

                <RelativeLayout
                        android:layout_marginTop="@dimen/margin_medium"
                        android:layout_width="@dimen/image_large"
                        android:layout_below="@id/labelFoto"
                        android:layout_height="@dimen/image_large">
                    <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/mitraImageView"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/ic_add_image"/>
                </RelativeLayout>
            </RelativeLayout>

            <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/submitButton"
                    android:layout_marginTop="@dimen/margin_large"
                    style="@style/submitButton"/>
            <View style="@style/Devider"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>