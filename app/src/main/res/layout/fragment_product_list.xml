<?xml version="1.0" encoding="utf-8"?>
<android.support.design.widget.CoordinatorLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent" android:layout_height="match_parent">

    <include layout="@layout/base_appbar_primary_with_logo"/>

    <android.support.v4.widget.SwipeRefreshLayout
            android:id="@+id/productListSwipe"
            android:layout_width="match_parent"
            android:background="@color/white"
            android:layout_height="wrap_content"
            app:layout_behavior="android.support.design.widget.AppBarLayout$ScrollingViewBehavior">

        <android.support.v4.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent">
            <LinearLayout
                    android:layout_width="match_parent"
                    android:padding="@dimen/margin_medium"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                <android.support.v7.widget.AppCompatTextView
                        android:id="@+id/titleProduct"
                        style="@style/headerTextView"
                        android:textSize="@dimen/text_normal"/>

                <android.support.v7.widget.AppCompatTextView
                        android:id="@+id/descriptionProduct"
                        android:layout_marginTop="@dimen/margin_small"
                        style="@style/normalTextView"
                        android:textColor="@color/grey"/>

                <RelativeLayout
                        android:layout_marginTop="@dimen/margin_medium"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                    <android.support.v7.widget.RecyclerView
                            android:id="@+id/productRecycleView"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"/>

                    <LinearLayout
                            android:id="@+id/areaNoPackage"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/margin_medium"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">
                        <android.support.v7.widget.AppCompatImageView
                                android:layout_width="@dimen/image_big"
                                android:layout_height="@dimen/image_big"
                                android:background="@drawable/base_circle_primary"
                                android:src="@drawable/logo_klikacara"/>

                        <android.support.v7.widget.AppCompatTextView
                                style="@style/normalTextView"
                                android:text="Maaf belum ada paket tersedia"
                                android:textColor="@color/grey"
                                android:gravity="center"
                                android:layout_marginTop="@dimen/margin_medium"/>
                    </LinearLayout>

                    <com.wang.avi.AVLoadingIndicatorView
                            android:id="@+id/loadingProductList"
                            android:layout_marginTop="@dimen/margin_medium"
                            android:layout_centerHorizontal="true"
                            style="@style/Loading"/>
                </RelativeLayout>

            </LinearLayout>
        </android.support.v4.widget.NestedScrollView>
    </android.support.v4.widget.SwipeRefreshLayout>

    <android.support.design.widget.FloatingActionButton
            android:id="@+id/addProductButton"
            android:layout_width="wrap_content"
            android:src="@drawable/ic_add_white"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="@dimen/margin_medium"
            android:layout_marginBottom="@dimen/margin_medium"
            android:layout_height="wrap_content"/>

</android.support.design.widget.CoordinatorLayout>