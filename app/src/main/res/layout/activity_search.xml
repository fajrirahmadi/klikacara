<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
		xmlns:tools="http://schemas.android.com/tools"
		xmlns:app="http://schemas.android.com/apk/res-auto"
		android:orientation="vertical"
		android:layout_width="match_parent"
		android:background="@color/white"
		android:layout_height="match_parent">

	<com.google.android.material.appbar.AppBarLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:background="@color/white">

		<androidx.appcompat.widget.Toolbar
				android:id="@+id/toolbar"
				android:layout_width="match_parent"
				android:layout_height="56dp">

			<RelativeLayout
					android:layout_width="match_parent"
					android:layout_height="match_parent"
					android:gravity="center_vertical">

				<androidx.appcompat.widget.AppCompatTextView
						android:id="@+id/titleToolbar"
						style="@style/normalTextView"
						android:layout_centerVertical="true"
						android:visibility="gone"
						android:fontFamily="@font/font_lato_bold"
						android:textColor="@color/colorPrimaryDark"
						android:textSize="@dimen/text_normal" />

				<androidx.appcompat.widget.AppCompatEditText
						android:id="@+id/searchEditText"
						style="@style/normalEditText"
						android:hint="@string/label_cari_acara"
						android:layout_marginEnd="@dimen/margin_medium"
						android:paddingStart="@dimen/margin_small"
						android:paddingEnd="@dimen/margin_small"
						android:drawableStart="@drawable/ic_search_new"
						android:drawableTint="@color/grey"
						android:gravity="center_vertical"
						android:drawablePadding="@dimen/margin_small"
						android:layout_centerVertical="true"
						android:textSize="@dimen/text_medium"
						android:singleLine="true"
						android:layout_height="40dp"
						android:background="@drawable/border_grey"
						tools:ignore="UnusedAttribute" />

				<androidx.appcompat.widget.AppCompatImageView
						android:id="@+id/clearButton"
						android:layout_width="24dp"
						android:layout_height="24dp"
						android:visibility="gone"
						android:padding="2dp"
						android:layout_alignParentEnd="true"
						android:layout_centerVertical="true"
						android:layout_marginEnd="@dimen/margin_big"
						android:src="@drawable/ic_close" />
			</RelativeLayout>
		</androidx.appcompat.widget.Toolbar>
	</com.google.android.material.appbar.AppBarLayout>

	<androidx.swiperefreshlayout.widget.SwipeRefreshLayout
			android:id="@+id/swipeSearch"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior">

		<androidx.core.widget.NestedScrollView
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:fillViewport="true">

			<RelativeLayout
					android:layout_width="match_parent"
					android:layout_height="match_parent">

				<androidx.recyclerview.widget.RecyclerView
						android:padding="@dimen/margin_medium"
						android:id="@+id/searchListRecycleView"
						android:layout_width="match_parent"
						android:layout_height="match_parent" />

				<include layout="@layout/content_error" />

				<include layout="@layout/content_loading" />
			</RelativeLayout>

		</androidx.core.widget.NestedScrollView>

	</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>