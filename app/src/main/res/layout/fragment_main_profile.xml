<?xml version="1.0" encoding="utf-8"?>
<android.support.design.widget.CoordinatorLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:background="@color/white"
        android:layout_height="match_parent">

    <include layout="@layout/base_appbar_primary_with_title"/>

    <android.support.v4.widget.SwipeRefreshLayout
            android:id="@+id/swipeProfile"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="android.support.design.widget.AppBarLayout$ScrollingViewBehavior">

        <android.support.v4.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent">

            <RelativeLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                <LinearLayout
                        android:id="@+id/loginArea"
                        android:visibility="gone"
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                    <android.support.v7.widget.CardView
                            style="@style/CardNormal">
                        <RelativeLayout
                                android:padding="@dimen/margin_medium"
                                android:background="@color/white"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">
                            <android.support.v7.widget.AppCompatImageView
                                    android:id="@+id/profileImageView"
                                    android:layout_width="@dimen/image_normal"
                                    android:layout_height="@dimen/image_normal"
                                    android:layout_marginEnd="@dimen/margin_medium"
                                    android:background="@drawable/base_circle_primary"/>

                            <android.support.v7.widget.AppCompatTextView
                                    android:id="@+id/nameTextView"
                                    style="@style/headerTextView"
                                    android:textSize="@dimen/text_medium"
                                    android:text="Fajri Rahmadi"
                                    android:layout_toEndOf="@id/profileImageView"/>

                            <android.support.v7.widget.AppCompatTextView
                                    android:id="@+id/roleTextView"
                                    style="@style/normalTextView"
                                    android:text="Pengguna"
                                    android:layout_width="wrap_content"
                                    android:layout_below="@id/nameTextView"
                                    android:layout_toEndOf="@id/profileImageView"
                                    android:textColor="@color/grey"/>

                            <android.support.v7.widget.AppCompatTextView
                                    android:id="@+id/registerVendorButton"
                                    style="@style/normalTextView"
                                    android:text="Menjadi Vendor"
                                    android:layout_width="wrap_content"
                                    android:layout_below="@id/roleTextView"
                                    android:layout_toEndOf="@id/profileImageView"
                                    android:layout_marginTop="@dimen/margin_small"
                                    android:background="@drawable/base_button_primary"
                                    android:textColor="@color/white"
                                    android:paddingStart="@dimen/margin_small"
                                    android:paddingEnd="@dimen/margin_small"
                                    android:paddingTop="@dimen/margin_very_small"
                                    android:paddingBottom="@dimen/margin_very_small"/>
                        </RelativeLayout>
                    </android.support.v7.widget.CardView>

                    <View style="@style/Line"
                          android:background="#10000000"
                          android:layout_marginTop="@dimen/margin_medium"/>

                    <android.support.v7.widget.RecyclerView
                            android:id="@+id/profileMenuRecycleView"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"/>

                    <View style="@style/Devider"/>
                </LinearLayout>

                <include
                        android:id="@+id/notLoginArea"
                        android:visibility="gone"
                        layout="@layout/content_login_first"/>

                <com.wang.avi.AVLoadingIndicatorView
                        android:id="@+id/loadingProfile"
                        style="@style/Loading"
                        android:layout_centerInParent="true"
                        android:layout_marginTop="@dimen/margin_very_large"/>
            </RelativeLayout>

        </android.support.v4.widget.NestedScrollView>

    </android.support.v4.widget.SwipeRefreshLayout>

</android.support.design.widget.CoordinatorLayout>