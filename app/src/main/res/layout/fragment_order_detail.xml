<?xml version="1.0" encoding="utf-8"?>
<android.support.design.widget.CoordinatorLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent" android:layout_height="match_parent">

    <include layout="@layout/base_appbar_primary_with_logo"/>

    <android.support.v4.widget.SwipeRefreshLayout
            android:id="@+id/productListSwipe"
            android:layout_width="match_parent"
            android:background="@color/white"
            android:layout_height="wrap_content"
            app:layout_behavior="android.support.design.widget.AppBarLayout$ScrollingViewBehavior">

        <android.support.v4.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent">
            <LinearLayout
                    android:padding="@dimen/margin_medium"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                <android.support.v7.widget.AppCompatTextView
                        style="@style/headerTextView"
                        android:textSize="@dimen/text_normal"
                        android:text="Masukkan Detail Acara Anda"/>

                <android.support.v7.widget.AppCompatTextView
                        style="@style/normalTextView"
                        android:layout_marginTop="@dimen/margin_medium"
                        android:text="@string/label_nama_acara"/>
                <android.support.v7.widget.AppCompatEditText
                        android:id="@+id/namaAcaraEditText"
                        style="@style/registrationForm"
                        android:layout_marginTop="@dimen/margin_small"
                        android:hint="@string/label_nama_acara"/>

                <android.support.v7.widget.AppCompatTextView
                        style="@style/normalTextView"
                        android:layout_marginTop="@dimen/margin_medium"
                        android:text="@string/label_penanggung_jawab"/>
                <android.support.v7.widget.AppCompatEditText
                        android:id="@+id/penanggungJawabEditText"
                        style="@style/registrationForm"
                        android:layout_marginTop="@dimen/margin_small"
                        android:hint="@string/label_penanggung_jawab"/>

                <android.support.v7.widget.AppCompatTextView
                        style="@style/normalTextView"
                        android:layout_marginTop="@dimen/margin_medium"
                        android:text="@string/label_email"/>
                <android.support.v7.widget.AppCompatEditText
                        android:id="@+id/emailEditText"
                        style="@style/registrationForm"
                        android:layout_marginTop="@dimen/margin_small"
                        android:hint="@string/label_email"/>

                <android.support.v7.widget.AppCompatTextView
                        style="@style/normalTextView"
                        android:layout_marginTop="@dimen/margin_medium"
                        android:text="@string/label_phone"/>
                <android.support.v7.widget.AppCompatEditText
                        android:id="@+id/phoneEditText"
                        style="@style/registrationForm"
                        android:layout_marginTop="@dimen/margin_small"
                        android:inputType="number"
                        android:hint="@string/label_phone"/>

            </LinearLayout>
        </android.support.v4.widget.NestedScrollView>
    </android.support.v4.widget.SwipeRefreshLayout>

    <android.support.v7.widget.AppCompatButton
            android:id="@+id/nextButton"
            android:layout_below="@id/fakeLine"
            android:background="@color/colorPrimary"
            android:text="BERIKUTNYA"
            android:layout_gravity="bottom"
            android:textColor="@color/white"
            style="@style/normalButton"/>

</android.support.design.widget.CoordinatorLayout>