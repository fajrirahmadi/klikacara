<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:background="@color/white"
        android:layout_height="match_parent">

    <include layout="@layout/base_appbar_primary_with_logo"/>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeHome"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior">

        <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent">

            <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                    <RelativeLayout
                            android:id="@+id/areaBanner"
                            android:layout_width="match_parent"
                            android:layout_height="150dp">

                        <androidx.viewpager.widget.ViewPager
                                android:id="@+id/bannerPager"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"/>

                        <com.google.android.material.tabs.TabLayout
                                android:id="@+id/tabDots"
                                android:layout_alignParentBottom="true"
                                android:layout_width="wrap_content"
                                android:layout_centerHorizontal="true"
                                android:layout_height="wrap_content"
                                app:tabBackground="@drawable/dots_background"
                                app:tabGravity="center"
                                app:tabIndicatorHeight="0dp"/>
                    </RelativeLayout>
                    <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/bannerRecycleView"
                            android:layout_width="match_parent"
                            android:visibility="gone"
                            android:layout_height="wrap_content"/>

                    <com.wang.avi.AVLoadingIndicatorView
                            android:id="@+id/bannerLoading"
                            style="@style/Loading"
                            android:layout_margin="@dimen/margin_large"
                            android:layout_centerInParent="true"/>
                </RelativeLayout>

                <RelativeLayout
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_marginTop="@dimen/margin_medium"
                        android:layout_marginStart="@dimen/margin_medium"
                        android:layout_marginEnd="@dimen/margin_medium"
                        android:layout_height="wrap_content">

                    <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/titleEventTextView"
                            style="@style/headerTextView"
                            android:layout_marginBottom="@dimen/margin_medium"
                            android:text="@string/label_acara_terbaru"/>

                    <androidx.recyclerview.widget.RecyclerView
                            android:layout_below="@+id/titleEventTextView"
                            android:id="@+id/eventRecycleView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"/>
                </RelativeLayout>

                <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_marginTop="@dimen/margin_medium"
                        android:layout_marginStart="@dimen/margin_medium"
                        android:layout_marginEnd="@dimen/margin_medium"
                        android:layout_height="wrap_content">

                    <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/titlePerlengkapanTextView"
                            style="@style/headerTextView"
                            android:textSize="@dimen/text_normal"
                            android:layout_marginBottom="@dimen/margin_medium"
                            android:text="@string/label_perlengkapan_acara"/>

                    <androidx.recyclerview.widget.RecyclerView
                            android:visibility="gone"
                            android:layout_below="@+id/titlePerlengkapanTextView"
                            android:id="@+id/perlengkapanRecycleView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"/>

                    <com.wang.avi.AVLoadingIndicatorView
                            android:id="@+id/perlengkapanLoading"
                            style="@style/Loading"
                            android:layout_below="@id/titlePerlengkapanTextView"
                            android:layout_margin="@dimen/margin_large"
                            android:layout_centerHorizontal="true"/>
                </RelativeLayout>

                <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_marginTop="@dimen/margin_medium"
                        android:layout_marginStart="@dimen/margin_medium"
                        android:layout_marginEnd="@dimen/margin_medium"
                        android:layout_height="wrap_content">

                    <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/titlePaketAcaraTextView"
                            style="@style/headerTextView"
                            android:textSize="@dimen/text_normal"
                            android:layout_marginBottom="@dimen/margin_medium"
                            android:text="@string/paket_acara"/>

                    <androidx.recyclerview.widget.RecyclerView
                            android:layout_below="@+id/titlePaketAcaraTextView"
                            android:id="@+id/paketAcaraRecycleView"
                            android:layout_width="match_parent"
                            android:visibility="gone"
                            android:layout_height="wrap_content"/>

                    <com.wang.avi.AVLoadingIndicatorView
                            android:id="@+id/paketAcaraLoading"
                            style="@style/Loading"
                            android:layout_below="@id/titlePaketAcaraTextView"
                            android:layout_margin="@dimen/margin_large"
                            android:layout_centerHorizontal="true"/>
                </RelativeLayout>

                <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_marginTop="@dimen/margin_medium"
                        android:layout_marginStart="@dimen/margin_medium"
                        android:layout_marginEnd="@dimen/margin_medium"
                        android:layout_height="wrap_content">

                    <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/titlePengisiAcaraTextView"
                            style="@style/headerTextView"
                            android:textSize="@dimen/text_normal"
                            android:layout_marginBottom="@dimen/margin_medium"
                            android:text="@string/label_pengisi_acara"/>

                    <androidx.recyclerview.widget.RecyclerView
                            android:layout_below="@+id/titlePengisiAcaraTextView"
                            android:id="@+id/pengisiAcaraRecycleView"
                            android:layout_width="match_parent"
                            android:visibility="gone"
                            android:layout_height="wrap_content"/>

                    <com.wang.avi.AVLoadingIndicatorView
                            android:id="@+id/pengisiAcaraLoading"
                            style="@style/Loading"
                            android:layout_below="@id/titlePengisiAcaraTextView"
                            android:layout_margin="@dimen/margin_large"
                            android:layout_centerHorizontal="true"/>
                </RelativeLayout>

                <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_marginTop="@dimen/margin_medium"
                        android:layout_marginStart="@dimen/margin_medium"
                        android:layout_marginEnd="@dimen/margin_medium"
                        android:layout_height="wrap_content">

                    <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/titleUlasanTextView"
                            style="@style/headerTextView"
                            android:textSize="@dimen/text_normal"
                            android:layout_marginBottom="@dimen/margin_medium"
                            android:text="@string/label_kata_mereka_tentang_klik_acara"/>

                    <androidx.recyclerview.widget.RecyclerView
                            android:layout_below="@+id/titleUlasanTextView"
                            android:id="@+id/ulasanRecycleView"
                            android:layout_width="match_parent"
                            android:visibility="gone"
                            android:layout_height="wrap_content"/>

                    <com.wang.avi.AVLoadingIndicatorView
                            android:id="@+id/ulasanLoading"
                            style="@style/Loading"
                            android:layout_below="@id/titleUlasanTextView"
                            android:layout_margin="@dimen/margin_large"
                            android:layout_centerHorizontal="true"/>
                </RelativeLayout>

                <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_marginTop="@dimen/margin_medium"
                        android:layout_marginStart="@dimen/margin_medium"
                        android:layout_marginEnd="@dimen/margin_medium"
                        android:layout_marginBottom="@dimen/margin_medium"
                        android:layout_height="wrap_content">

                    <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/titleMitraTextView"
                            style="@style/headerTextView"
                            android:textSize="@dimen/text_normal"
                            android:layout_marginBottom="@dimen/margin_medium"
                            android:text="@string/label_mitra_klik_acara"/>

                    <androidx.recyclerview.widget.RecyclerView
                            android:layout_below="@+id/titleMitraTextView"
                            android:id="@+id/mitraRecycleView"
                            android:layout_width="match_parent"
                            android:visibility="gone"
                            android:layout_height="wrap_content"/>

                    <com.wang.avi.AVLoadingIndicatorView
                            android:id="@+id/mitraLoading"
                            style="@style/Loading"
                            android:layout_below="@id/titleMitraTextView"
                            android:layout_margin="@dimen/margin_large"
                            android:layout_centerHorizontal="true"/>
                </RelativeLayout>

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>