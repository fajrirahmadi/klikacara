<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
        xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
    <LinearLayout
            android:orientation="vertical"
            android:background="@color/white"
            android:layout_width="match_parent"
            android:padding="@dimen/margin_medium"
            android:layout_height="match_parent">

        <androidx.appcompat.widget.AppCompatTextView
                style="@style/latoRegularTextView"
                android:layout_marginTop="@dimen/margin_medium"
                android:visibility="gone"
                android:text="@string/description_login_form"
                android:gravity="center"/>

        <androidx.cardview.widget.CardView
                android:layout_marginTop="@dimen/margin_large"
                android:layout_marginStart="@dimen/no_margin"
                android:layout_marginEnd="@dimen/no_margin"
                style="@style/CardNormal">
            <LinearLayout
                    android:padding="@dimen/margin_medium"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                <androidx.appcompat.widget.AppCompatTextView
                        style="@style/headerTextView"
                        android:text="Selamat Datang di Klik Acara"
                        android:textColor="@color/colorPrimary"
                        android:textSize="@dimen/text_big"
                        android:gravity="center"/>

                <androidx.appcompat.widget.AppCompatTextView
                        style="@style/normalTextView"
                        android:gravity="center"
                        android:layout_marginTop="@dimen/margin_medium"
                        android:text="Nikmati pengalaman memesan yang lebih cepat dan keuntungan lainnya dengan daftar akun sekarang."/>

                <androidx.appcompat.widget.AppCompatTextView
                        android:layout_marginTop="@dimen/margin_large"
                        style="@style/normalTextView"
                        android:text="@string/label_email"/>
                <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/emailInputLayout"
                        android:layout_width="match_parent"
                        app:hintEnabled="false"
                        app:hintAnimationEnabled="false"
                        android:layout_marginTop="@dimen/margin_small"
                        android:layout_height="wrap_content">
                    <androidx.appcompat.widget.AppCompatEditText
                            android:id="@+id/emailEditText"
                            style="@style/registrationForm"
                            android:layout_marginTop="@dimen/margin_small"
                            android:hint="@string/label_email"/>
                </com.google.android.material.textfield.TextInputLayout>

                <androidx.appcompat.widget.AppCompatTextView
                        style="@style/normalTextView"
                        android:layout_marginTop="@dimen/margin_medium"
                        android:text="@string/label_password"/>
                <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/passwordInputLayout"
                        app:passwordToggleEnabled="true"
                        android:layout_width="match_parent"
                        app:hintEnabled="false"
                        app:hintAnimationEnabled="false"
                        android:layout_marginTop="@dimen/margin_small"
                        android:layout_height="wrap_content">
                    <androidx.appcompat.widget.AppCompatEditText
                            android:id="@+id/passwordEditText"
                            style="@style/registrationForm"
                            android:inputType="textPassword"
                            android:hint="@string/label_password"/>
                </com.google.android.material.textfield.TextInputLayout>

                <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/forgetPasswordButton"
                        style="@style/latoRegularTextView"
                        android:layout_width="wrap_content"
                        android:layout_marginTop="@dimen/margin_medium"
                        android:layout_gravity="end"
                        android:text="@string/label_forgot_password"/>

                <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/loginButton"
                        android:layout_marginTop="@dimen/margin_large"
                        style="@style/loginButton"/>

                <androidx.appcompat.widget.AppCompatTextView
                        style="@style/normalTextView"
                        android:text="Atau"
                        android:gravity="center"
                        android:textColor="@color/grey"
                        android:layout_marginTop="@dimen/margin_medium"/>

                <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/loginWithGoogle"
                        android:text="Masuk dengan google"
                        android:layout_marginTop="@dimen/margin_medium"
                        style="@style/loginButton"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <LinearLayout
                android:layout_marginTop="@dimen/margin_medium"
                android:layout_gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
            <androidx.appcompat.widget.AppCompatTextView
                    style="@style/latoRegularTextView"
                    android:text="@string/label_dont_have_account"/>
            <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/registerButton"
                    style="@style/latoSemiBoldTextView"
                    android:text="@string/label_register_now"
                    android:textSize="@dimen/text_medium"
                    android:textColor="@color/colorPrimary"
                    android:layout_marginStart="@dimen/margin_small"/>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>